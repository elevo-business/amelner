# ============================================================
# Amelner Getreidebrand — Apache-Konfiguration (Hosteurope)
# ============================================================

AddDefaultCharset UTF-8
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Auf https://amelner.de vereinheitlichen ---------------------------
  # ACHTUNG: Erst hochladen, wenn das SSL-Zertifikat im KIS aktiv ist.
  # Fehlt es noch, diese beiden Bloecke voruebergehend auskommentieren —
  # sonst leitet der Server auf eine Adresse weiter, die es noch nicht gibt.

  # www entfernen
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://amelner.de%{REQUEST_URI} [R=301,L]

  # HTTP auf HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://amelner.de%{REQUEST_URI} [R=301,L]

  # --- Alte Adressen der Vorgaengerseite auffangen -----------------------
  # Die alte Seite war ein Einseiter mit Ankern. Wer noch einen alten Link
  # hat, landet jetzt beim passenden Kapitel statt auf einer Fehlerseite.
  RewriteRule ^produkte/?$        /likoere.html   [R=301,L]
  RewriteRule ^geschichte/?$      /chronik.html   [R=301,L]
  RewriteRule ^haendler/?$        /haendler.html  [R=301,L]
  RewriteRule ^kontakt/?$         /bestellen.html [R=301,L]
  RewriteRule ^index\.php$        /               [R=301,L]
</IfModule>

# --- Komprimierung ------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Zwischenspeicher ---------------------------------------------------
# Bilder tragen die Breite im Dateinamen und aendern sich nicht mehr,
# deshalb duerfen sie lange liegenbleiben. HTML bleibt kurz.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType text/html               "access plus 1 hour"
</IfModule>

# --- Sicherheitskopfzeilen ---------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Korrekte Auslieferung ---------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/xml .xml
</IfModule>
